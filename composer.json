{
    "name": "jakub-filip/whmcs-tpay",
    "description": "Tpay payment gateway module for WHMCS",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jakub Filip",
            "email": "jakubfilip@innovativesoftwarecenter.dev"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "JakubFilip\\Tpay\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JakubFilip\\Tpay\\Tests\\": "./tests/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
